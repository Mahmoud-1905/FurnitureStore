@model FurnitureStore.ViewModels.AdminCustomersViewModel
@{
    ViewData["Title"] = "Customer Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="bg-white rounded-2xl shadow-[0_2px_10px_rgba(0,0,0,0.04)] border border-gray-100 overflow-hidden">
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
        <h2 class="text-lg font-bold text-gray-900">Registered Customers</h2>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-gray-50 text-gray-600">
                <tr>
                    <th class="px-6 py-4 font-semibold">Name</th>
                    <th class="px-6 py-4 font-semibold">Email</th>
                    <th class="px-6 py-4 font-semibold">Joined Date</th>
                    <th class="px-6 py-4 font-semibold">Status</th>
                    <th class="px-6 py-4 font-semibold text-right">Action</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var user in Model.Customers)
                {
                    if (user.Email?.ToLower() == "admin@furniturestore.com")
                    {
                        continue;
                    }
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4 font-medium text-gray-900">
                            <div class="flex items-center gap-3">
                                <div class="h-8 w-8 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold">
                                    @(string.IsNullOrEmpty(user.FullName) ? "?" : user.FullName.Substring(0,1).ToUpper())
                                </div>
                                @user.FullName
                            </div>
                        </td>
                        <td class="px-6 py-4 text-gray-500">@user.Email</td>
                        <td class="px-6 py-4 text-gray-500">@user.CreatedAt.ToString("MMM dd, yyyy")</td>
                        <td class="px-6 py-4">
                            @if(user.IsActive)
                            {
                                <span class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-full text-xs font-medium bg-green-50 text-green-700">Active</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-full text-xs font-medium bg-red-50 text-red-700">Deactivated</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-right">
                            <form asp-action="ToggleCustomerStatus" method="post">
                                <input type="hidden" name="userId" value="@user.Id" />
                                @if (user.IsActive)
                                {
                                    <button type="submit" class="text-red-600 hover:text-red-800 font-medium text-sm transition-colors">Deactivate</button>
                                }
                                else
                                {
                                    <button type="submit" class="text-green-600 hover:text-green-800 font-medium text-sm transition-colors">Activate</button>
                                }
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

        @* Language selection prompt *@
        <script>
            // Show language choice only once per session
            if (!sessionStorage.getItem('adminLangChosen')) {
                const useArabic = confirm('Do you want to view the admin pages in Arabic? OK = Arabic, Cancel = English');
                const lang = useArabic ? 'ar' : 'en';
                // Store choice and reload to apply
                sessionStorage.setItem('adminLangChosen', lang);
                // Simple way: set a cookie that server can read on next request (if you have localization middleware)
                document.cookie = `adminLang=${lang}; path=/`; // server can use this cookie to set culture
                location.reload();
            }
        </script>
