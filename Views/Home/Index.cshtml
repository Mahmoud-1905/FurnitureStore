@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["HeroTitle"].Value.Replace("<br />", " ");
}


    <!-- Swiper -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.css" />

    <style>
        /* =========================
                                       HERO ANIMATIONS
                                    ========================== */

        @@keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(40px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-fade-up {
            animation: fadeInUp 1.2s ease-out forwards;
        }

        @@keyframes slowZoom {
            0% {
                transform: scale(1.05);
            }

            100% {
                transform: scale(1.15);
            }
        }

        .animate-slow-zoom {
            animation: slowZoom 12s ease-in-out infinite alternate;
        }

        @@keyframes floatY {
            0% {
                transform: translateY(0px);
            }

            50% {
                transform: translateY(-10px);
            }

            100% {
                transform: translateY(0px);
            }
        }

        .animate-float {
            animation: floatY 5s ease-in-out infinite;
        }

        /* =========================
                                       GLASS EFFECT
                                    ========================== */

        .glass-card {
            backdrop-filter: blur(18px);
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        /* =========================
                                       HOVER EFFECT
                                    ========================== */

        .hover-lift {
            transition: all .6s ease;
        }

        .hover-lift:hover {
            transform: translateY(-12px);
            box-shadow: 0 30px 60px rgba(0, 0, 0, .18);
        }

        /* =========================
                                       SCROLL REVEAL
                                    ========================== */

        .hidden-element {
            opacity: 0;
            transform: translateY(60px);
            transition: all 1s ease;
        }

        .show-element {
            opacity: 1;
            transform: translateY(0);
        }

        /* =========================
                                       BUTTON EFFECT
                                    ========================== */

        .premium-btn {
            position: relative;
            overflow: hidden;
        }

        .premium-btn::before {
            content: "";
            position: absolute;
            inset: 0;
            background: #c8a97e;
            transform: translateY(100%);
            transition: .5s ease;
            z-index: 0;
        }

        .premium-btn:hover::before {
            transform: translateY(0);
        }

        .premium-btn span {
            position: relative;
            z-index: 10;
        }

        /* =========================
                                       SWIPER
                                    ========================== */

        .luxurySwiper .swiper-slide {
            transition: .6s ease;
            opacity: .5;
            transform: scale(.92);
        }

        .luxurySwiper .swiper-slide-active {
            opacity: 1;
            transform: scale(1);
        }

        .luxurySwiper .swiper-button-next { right: -2rem !important; left: auto !important; }
        .luxurySwiper .swiper-button-prev { left: -2rem !important; right: auto !important; }
        
        html[dir="rtl"] .luxurySwiper .swiper-button-next,
        .swiper-rtl .luxurySwiper .swiper-button-next { right: auto !important; left: -2rem !important; }
        
        html[dir="rtl"] .luxurySwiper .swiper-button-prev,
        .swiper-rtl .luxurySwiper .swiper-button-prev { left: auto !important; right: -2rem !important; }

        .py-section-gap {
            padding-top: 100px !important;
            padding-bottom: 0 !important;
        }

        .DiscoverAllSpan{
            font-size: 1rem;
                    line-height: 1rem;}
       
        
        </style>

<main>

    <!-- =========================
         HERO SECTION
    ========================== -->

    <section class="relative min-h-[95vh] flex flex-col justify-center px-8 md:px-16 overflow-hidden">

        <!-- Background -->
        <div class="absolute inset-0 -z-10 overflow-hidden">

            <div class="absolute inset-0 bg-gradient-to-br from-black/60 via-black/20 to-black/70 z-10"></div>

            <img class="w-full h-full object-cover animate-slow-zoom"
                 src="https://images.unsplash.com/photo-1618221195710-dd6b41faaea6?q=80&w=2000&auto=format&fit=crop" />

            <!-- Blur Effects -->
            <div class="absolute top-10 left-10 w-72 h-72 bg-primary/20 rounded-full blur-3xl animate-pulse"></div>

            <div class="absolute bottom-10 right-10 w-96 h-96 bg-white/10 rounded-full blur-3xl animate-pulse"></div>

        </div>

        <div class="container-center grid grid-cols-1 md:grid-cols-12 gap-gutter">

            <div class="md:col-span-8 flex flex-col justify-center animate-fade-up">

                <h1 class="text-6xl md:text-8xl font-serif text-white leading-tight">
                    @Html.Raw(Localizer["HeroTitle"].Value)
                </h1>

                <p class="text-xl md:text-2xl font-sans text-white/80 max-w-xl mb-stack-lg leading-relaxed">
                    @Localizer["HeroSubtitle"]
                </p>

                <div class="flex flex-wrap gap-stack-md items-center">

                    <!-- BUTTON -->
                    <a href="/Products"
                       class="premium-btn bg-white text-black px-10 py-4 uppercase tracking-widest text-sm transition-all duration-500">

                        <span>
                            @Localizer["ExploreCollection"]
                        </span>

                    </a>

                </div>

            </div>

        </div>

    </section>

    <!-- =========================
         PHILOSOPHY SECTION
    ========================== -->

    <section class="py-section-gap px-8 md:px-16 bg-surface hidden-element">

        <div class="container-center grid grid-cols-1 md:grid-cols-12 items-center gap-16">

            <div class="md:col-span-5 order-2 ltr:md:order-1 rtl:md:order-1 ltr:text-left rtl:text-right">

                <span class="text text-primary uppercase tracking-[0.2em] block mb-stack-sm"                     style=".text {font-size: 1rem;
                    line-height: 1rem;}">
                    @Localizer["PhilosophySubtitle"]
                </span>

                <h2 class="text-4xl md:text-5xl font-serif text-on-surface mb-stack-md leading-tight">
                    @Localizer["PhilosophyTitle"]
                </h2>

                <p class="text-lg text-secondary leading-relaxed">
                    @Localizer["PhilosophyText"]
                </p>

                <a href="/About"
                   class="inline-flex items-center gap-3 text-primary hover:text-black transition-colors group mt-4">
                    <span class="DiscoverAllSpan uppercase tracking-widest font-medium">
                        @Localizer["DiscoverAll"]
</span>
                    <span class="w-8 h-[1px] bg-primary group-hover:w-12 transition-all duration-300"></span>
                    <svg class="w-4 h-4 transform rtl:rotate-180 group-hover:translate-x-1 rtl:group-hover:-translate-x-1 transition-transform"
                         fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </a>

            </div>

            <div class="md:col-span-7 order-1 ltr:md:order-2 rtl:md:order-2 flex  ltr:justify-end rtl:justify-start">

                <div class="grid grid-cols-2 gap-4 md:gap-6 w-11/12 lg:w-4/5 ltr:justify-items-start rtl:justify-items-end ltr:ml-auto rtl:mr-auto">

                    <img class="w-full aspect-[4/5] object-cover rounded-[24px] hover-lift shadow-lg"
                         src="https://cdn.salla.sa/PdZwwe/56e56ab7-6de6-48e1-8356-f0ab8c26bff1-993.97590361446x1000-hTQj86YWlbfsvAxJbnRXuGdCR4HeY4Z4RfADCijZ.png" />

                    <img class="w-full aspect-[4/5] object-cover mt-12 md:mt-20 rounded-[24px] hover-lift shadow-lg"
                         src="https://images.unsplash.com/photo-1616046229478-9901c5536a45?q=80&w=800&auto=format&fit=crop" />

                </div>

            </div>

        </div>

    </section>

    <!-- =========================
         SWIPER SECTION
    ========================== -->

    <section class="pt-5 px-8 md:px-16 bg-surface hidden-element relative" style="padding-bottom: 5rem;">

        <div class="mb-16 ltr:justify-end rtl:justify-start">

            <h2 class="text-5xl font-serif">
                @Localizer["FeaturedSpaces"]
            </h2>

        </div>

        <div class="relative">
            <div class="swiper luxurySwiper overflow-hidden">
    
                <div class="swiper-wrapper">
    
                    <div class="swiper-slide flex justify-center items-center" style="width: auto;">
    
                        <img class="w-[85vw] md:w-[500px] h-[300px] object-cover rounded-[40px]"
                             src="https://kitchenroom.co.uk/wp-content/uploads/2023/05/tetbury.webp" />
    
                    </div>
    
                    <div class="swiper-slide flex justify-center items-center" style="width: auto;">
    
                        <img class="w-[85vw] md:w-[500px] h-[300px] object-cover rounded-[40px]"
                             src="https://images.unsplash.com/photo-1494526585095-c41746248156?q=80&w=2000&auto=format&fit=crop" />
    
                    </div>
    
                    <div class="swiper-slide flex justify-center items-center" style="width: auto;">
    
                        <img class="w-[85vw] md:w-[500px] h-[300px] object-cover rounded-[40px]"
                             src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSoCVNeTen0ow70n_kthafKNNBmDJjHD3XxAMufM_tptwT9AObN45cocjA&s=10" />
    
                    </div>

                    <div class="swiper-slide flex justify-center items-center" style="width: auto;">
    
                        <img class="w-[85vw] md:w-[500px] h-[300px] object-cover rounded-[40px]"
                             src="https://www.marthastewart.com/thmb/wHITHqTOEAQJrYUJqvgjL11gdsQ=/1500x0/filters:no_upscale():max_bytes(150000):strip_icc()/BradRamseyInteriors_credit_CarolineSharpnack1-48ba1335d5c44e58be35db02d160fea2.jpg" />
    
                    </div>
    
                    <div class="swiper-slide flex justify-center items-center" style="width: auto;">
    
                        <img class="w-[85vw] md:w-[500px] h-[300px] object-cover rounded-[40px]"
                             src="https://cdn.prod.website-files.com/6334a8d89862a1cc15eae9e1/64dd70b0e537179482d44e1d_1dc665d2.jpeg" />
    
                    </div>
    
                    <div class="swiper-slide flex justify-center items-center" style="width: auto;">
    
                        <img class="w-[85vw] md:w-[500px] h-[300px] object-cover rounded-[40px]"
                             src="https://i.pinimg.com/originals/e2/97/f5/e297f5a88222f0e4d19a9bdfbbe44ad2.jpg" />
    
                    </div>
                    <div class="swiper-slide flex justify-center items-center" style="width: auto;">

                        <img class="w-[85vw] md:w-[500px] h-[300px] object-cover rounded-[40px]"
                             src="https://toughenedglasssystems.co.uk/wp-content/uploads/2025/02/spacejoy-c0JoR_-2x3E-unsplash-1024x750.jpg" />

                    </div>
    
                </div>
    
            </div>
            
            <div class="swiper-button-next" style="color: #c8a97e;"></div>
            <div class="swiper-button-prev" style="color: #c8a97e;"></div>
        </div>

    </section>

</main>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/swiper/swiper-bundle.min.js"></script>

    <script>

        // =========================
        // SWIPER
        // =========================

        new Swiper(".luxurySwiper", {

        loop: true,

        speed: 1000,

        autoplay: {
        delay: 3500,
        },

        slidesPerView: "auto",

        centeredSlides: true,

        spaceBetween: 30,

        navigation: {
            nextEl: ".swiper-button-next",
            prevEl: ".swiper-button-prev",
        },

        });

        // =========================
        // SCROLL REVEAL
        // =========================

        const observer = new IntersectionObserver((entries) => {

        entries.forEach((entry) => {

        if (entry.isIntersecting) {

        entry.target.classList.add("show-element");

        }

        });

        });

        document.querySelectorAll(".hidden-element").forEach((el) => {

        observer.observe(el);

        });

    </script>

}