@model FurnitureStore.Models.Order

<h2 class="text-2xl font-serif mb-4">Order Completed</h2>

<p>Thank you! Your order <strong>#@Model.OrderId</strong> has been placed.</p>
<p>Status: @Model.PaymentStatus</p>
<p>Total Paid: @Model.TotalAmount:C</p>

@if (Model.Address != null)
{
    <h4 class="mt-4">Shipping Address</h4>
    <p>@Model.Address.AddressName<br />
       @Model.Address.StreetAddress<br />
       @Model.Address.City, @Model.Address.State @Model.Address.PostalCode<br />
       @Model.Address.Country
    </p>
}

@if (Model.Coupon != null)
{
    <p>Coupon Applied: @Model.Coupon.Code (Discount: @Model.DiscountAmount:C)</p>
}

<a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-4">Return Home</a>
