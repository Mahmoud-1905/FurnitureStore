@model FurnitureStore.ViewModels.OrderConfirmationViewModel

<h2 class="text-2xl font-serif mb-4">Confirm Your Order</h2>

<h4 class="font-medium">Shipping Address</h4>
@if (Model.Address != null) {
    <p>
        @Model.Address.AddressName <br />
        @Model.Address.StreetAddress <br />
        @Model.Address.City, @Model.Address.State @Model.Address.PostalCode <br />
        @Model.Address.Country
    </p>
}

<table class="table table-hover mt-4">
    <thead>
        <tr>
            <th>Product</th>
            <th>Qty</th>
            <th>Price</th>
            <th>Subtotal</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.CartItems)
        {
            <tr>
                <td>@item.Product.Name</td>
                <td>@item.Quantity</td>
                <td>@item.Product.Price:C</td>
                <td>@(item.Product.Price * item.Quantity):C</td>
            </tr>
        }
    </tbody>
</table>

<p><strong>Sub‑total:</strong> @Model.SubTotal:C</p>
@if (Model.DiscountAmount > 0)
{
    <p><strong>Discount:</strong> -@Model.DiscountAmount:C</p>
}
<p><strong>Total:</strong> @Model.Total:C</p>

<form asp-action="ProcessPayment" method="post" class="mt-4">
    <button type="submit" class="btn btn-success">Pay (Mock)</button>
</form>
