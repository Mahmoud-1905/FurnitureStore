@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer
@using FurnitureStore.ViewModels
@model ChangePasswordViewModel;

@{
    ViewData["Title"] = Localizer["Title"];
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
}

<div class="w-full">
    <h2 class="text-2xl font-serif text-on-surface mb-8 text-center">@Localizer["Header"]</h2>

    <form asp-action="ChangePassword" method="post" class="space-y-8">
        @Html.AntiForgeryToken()

        <!-- حقول مخفية ضرورية لإرسال البيانات -->
        <input type="hidden" asp-for="Email" />
        <input type="hidden" asp-for="Token" />

        <div asp-validation-summary="ModelOnly" class="text-xs text-error font-sans mb-4 text-center"></div>

        <!-- البريد الإلكتروني -->
        <div class="relative group">
            <label asp-for="Email" class="form-label block text-right">@Localizer["Email"]</label>
            <input asp-for="Email" class="form-input opacity-60 cursor-not-allowed bg-transparent border-b border-outline-variant w-full py-2 text-right" readonly />
        </div>

        <!-- كلمة المرور الجديدة -->
        <div class="relative group">
            <label asp-for="NewPassword" class="form-label block text-right">@Localizer["NewPassword"]</label>
            <input asp-for="NewPassword" type="password" class="form-input bg-transparent border-b border-outline-variant w-full py-2 text-right focus:outline-none focus:border-primary transition-colors" />
            <span asp-validation-for="NewPassword" class="text-[10px] text-error font-sans mt-1 block text-right"></span>
        </div>

        <!-- تأكيد كلمة المرور -->
        <div class="relative group">
            <label asp-for="ConfirmNewPassword" class="form-label block text-right">@Localizer["ConfirmNewPassword"]</label>
            <input asp-for="ConfirmNewPassword" type="password" class="form-input bg-transparent border-b border-outline-variant w-full py-2 text-right focus:outline-none focus:border-primary transition-colors" />
            <span asp-validation-for="ConfirmNewPassword" class="text-[10px] text-error font-sans mt-1 block text-right"></span>
        </div>

        <!-- زر الإرسال بنفس ستايل زر Login -->
        <button type="submit" class="w-full bg-on-surface text-surface py-4 font-sans text-xs uppercase tracking-[0.2em] hover:bg-primary transition-colors duration-500 rounded-none cursor-pointer mt-4">
            @Localizer["Submit"]
        </button>

        <!-- رابط الرجوع -->
        <div class="pt-6 border-t border-outline-variant/30 text-center">
            <a asp-controller="Account" asp-action="ForgotPassword" class="text-xs font-sans text-primary uppercase tracking-widest border-b border-primary/20 hover:border-primary transition-all pb-1">
                @Localizer["Back"]
            </a>
        </div>
    </form>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial.cshtml");
    }
}