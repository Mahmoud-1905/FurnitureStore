@model FurnitureStore.ViewModels.AdminReviewsViewModel
@{
    ViewData["Title"] = "Reviews Moderation";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="bg-white rounded-2xl shadow-[0_2px_10px_rgba(0,0,0,0.04)] border border-gray-100 overflow-hidden">
    <div class="p-6 border-b border-gray-100 flex justify-between items-center bg-gray-50/50">
        <h2 class="text-lg font-bold text-gray-900">Product Reviews</h2>
    </div>

    <div class="overflow-x-auto">
        <table class="w-full text-left text-sm">
            <thead class="bg-gray-50 text-gray-600">
                <tr>
                    <th class="px-6 py-4 font-semibold w-1/4">Product</th>
                    <th class="px-6 py-4 font-semibold w-1/4">Reviewer</th>
                    <th class="px-6 py-4 font-semibold w-1/3">Comment</th>
                    <th class="px-6 py-4 font-semibold">Rating</th>
                    <th class="px-6 py-4 font-semibold">Visibility</th>
                    <th class="px-6 py-4 font-semibold text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var review in Model.Reviews)
                {
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-6 py-4 text-gray-900 font-medium">@review.Product?.Name</td>
                        <td class="px-6 py-4 text-gray-500">
                            <div>@review.User?.FullName</div>
                            <div class="text-xs">@review.CreatedAt.ToString("MMM dd, yyyy")</div>
                        </td>
                        <td class="px-6 py-4 text-gray-700 italic">"@review.Body"</td>
                        <td class="px-6 py-4">
                            <div class="flex text-yellow-400 text-sm">
                                @for(int i = 0; i < review.Rating; i++) { <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 1">star</span> }
                                @for(int i = review.Rating; i < 5; i++) { <span class="material-symbols-outlined" style="font-variation-settings: 'FILL' 0">star</span> }
                            </div>
                        </td>
                        <td class="px-6 py-4">
                            @if(review.IsVisible)
                            {
                                <span class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-full text-xs font-medium bg-green-50 text-green-700">Visible</span>
                            }
                            else
                            {
                                <span class="inline-flex items-center gap-1.5 py-1 px-2.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">Hidden</span>
                            }
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-3">
                                <form asp-action="ToggleReviewVisibility" method="post">
                                    <input type="hidden" name="id" value="@review.ReviewId" />
                                    <button type="submit" class="text-blue-600 hover:text-blue-800 text-sm font-medium transition-colors" title="Toggle Visibility">
                                        @(review.IsVisible ? "Hide" : "Show")
                                    </button>
                                </form>
                                <span class="text-gray-300">|</span>
                                <form asp-action="DeleteReview" method="post" onsubmit="return confirm('Are you sure you want to permanently delete this review?');">
                                    <input type="hidden" name="id" value="@review.ReviewId" />
                                    <button type="submit" class="text-red-600 hover:text-red-800 text-sm font-medium transition-colors" title="Delete">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                @if(!Model.Reviews.Any())
                {
                    <tr><td colspan="6" class="px-6 py-8 text-center text-gray-500">No reviews found.</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>
